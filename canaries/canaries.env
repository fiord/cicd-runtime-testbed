# canaries/canaries.env
#
# 用途:
#   cicd-runtime-testbed の全カナリア値の定義。docs/SPEC.md 3節が実装契約。
#   各シナリオスクリプト (scenarios/*.sh) がこの値を注入し、
#   tools/scan-leaks.sh が telemetry アーティファクト中にこれらの値が
#   現れるかどうかを走査して T3 (secret 漏洩検証) の実測データを作る。
#
# 安全性:
#   すべて `CNRY` プレフィックスの偽値。実在の秘密情報・実在サービスの
#   キー形式に酷似した値は含まない。このファイル自体はリポジトリに
#   コミットされるため、tools/scan-leaks.sh は canaries/ ディレクトリ
#   自体をスキャン対象から除外しなければならない (除外しないと
#   「カナリアの定義ファイル自身」が常に漏洩ヒットしてしまう)。
#
# 値の制約 (docs/SPEC.md 3節を厳密に守ること。実装時に長さ・禁止語を
# 検算済み):
#   - CANARY_ARGV_SHORT は 12 バイト以下、かつ次の禁止キーワードを
#     含まないこと (大文字小文字を区別しない前提で検算済み):
#     token, key, auth, pass, secret, cred, bearer, AKIA, ghp_, glpat-
#   - CANARY_ARGV_LONG / CANARY_ARGV_FLAG も同じ禁止キーワードを含まない
#     こと (ARGV_LONG は 13 バイト以上、ARGV_FLAG は Authorization ヘッダの
#     値として使うため長さは任意)
#   - CANARY_DNS は DNS ラベルとして妥当であること (英数字とハイフンのみ、
#     先頭・末尾は英数字、63 文字以下)
#   - CANARY_SCAP は 200 バイト以下
#   - 長さに余裕がある値には `-DONOTUSE` を含める
#     (CANARY_ARGV_SHORT のみ長さ制約上、含められない)
#
# CANARY_ENV についての注記:
#   docs/SPEC.md 3節の唯一の例外で、"正しい漏洩テスト" のためには同じ値を
#   GitHub Secrets の CANARY_ENV にも登録する必要がある (登録手順は
#   README.md を参照)。ここに書く値はその際に登録すべき「フォールバック /
#   基準値」であり、scan-leaks.sh が grep するのもこの値。
#   Secret が未設定のジョブでは、ワークフロー側の
#   `env: CANARY_ENV: ${{ secrets.CANARY_ENV }}` は空文字列を渡す。
#   scenarios/lib/common.sh の load_canaries はジョブ環境にまだ
#   CANARY_ENV が来ていない (空) ことを検出したら TESTBED_LOG に記録し、
#   後続シナリオはこの canaries.env のフォールバック値で処理を続ける
#   (README 未設定時でも他のシナリオが動くようにするため)。

CANARY_ENV=CNRY-ENV-DONOTUSE-a1e4f7
CANARY_FILE=CNRY-FILE-DONOTUSE-b2d5c8
CANARY_PATH=CNRY-PATH-DONOTUSE-c3f6a9
CANARY_ARGV_SHORT=CNRYQ7K2M9XZ
CANARY_ARGV_LONG=CNRY-ARGVLONG-DONOTUSE-d4a7b1
CANARY_ARGV_FLAG=CNRY-ARGVFLAG-DONOTUSE-e5b8c2
CANARY_URL_QUERY=CNRY-URLQUERY-DONOTUSE-f6c9d3
CANARY_URL_PATH=CNRY-URLPATH-DONOTUSE-07dae4
CANARY_DNS=CNRY-DNS-DONOTUSE-18ebf5
CANARY_SCAP=CNRY-SCAP-DONOTUSE-29fc06-RAWSYSCALLBUFFERTEST
